<?xml version="1.0" encoding="utf-8"?>
<!--
  The app stores the Telegram bot token in an EncryptedSharedPreferences file.
  That file must never leave the device: the master key is Keystore-backed, so a
  restored copy would be unreadable anyway, and shipping the ciphertext off-device
  is pointless risk. Everything else (history DB, cache) is safe to back up.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="secure_settings.xml" />
    <exclude domain="database" path="history_database" />
    <exclude domain="database" path="history_database-wal" />
    <exclude domain="database" path="history_database-shm" />
    <exclude domain="external" path="." />
</full-backup-content>