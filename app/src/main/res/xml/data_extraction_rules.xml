<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup/transfer rules. Mirrors backup_rules.xml: the encrypted
  preferences holding the Telegram bot token are excluded, everything else is kept.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_settings.xml" />
        <exclude domain="database" path="history_database" />
        <exclude domain="database" path="history_database-wal" />
        <exclude domain="database" path="history_database-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_settings.xml" />
        <exclude domain="database" path="history_database" />
        <exclude domain="database" path="history_database-wal" />
        <exclude domain="database" path="history_database-shm" />
    </device-transfer>
</data-extraction-rules>